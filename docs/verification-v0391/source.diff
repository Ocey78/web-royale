+ A.equal(q.chests.length,4);A.doesNotMatch(row.innerHTML,/data-reward-kind="chest"/);A.match(row.innerHTML,/data-reward-kind="gold"/);A.match(row.innerHTML,/data-reward-kind="gems"/);
+});
